# === Бинарники и скомпилированные файлы ===
# Сами исполняемые файлы (результат go build)
*.exe
*.exe~
*.dll
*.so
*.dylib
# Если вы компилируете бинарник без расширения (под Linux/macOS)
# лучше указывать его имя явно, например:
# /myapp
# /vmadapter

# === Файлы тестирования ===
# Файлы с профилями покрытия кода тестами
*.out
*.prof
*.test

# === Локальные зависимости и кэш ===
# Папка vendor (если вы используете go mod vendor, обычно её не коммитят)
# vendor/
# Кэш сборки инструментов Buf (для gRPC)
.buf/

# === Конфигурации и Секреты ===
# Файлы окружения, где лежат пароли от БД, токены K8s и ключи libvirt
*.env
.env.*
config.local.yaml
config.local.json

# === Среды разработки (IDEs) ===
# VS Code
.vscode/*
!.vscode/launch.json  # Исключение: конфигурацию запуска c аргументами МОЖНО оставить в Git
!.vscode/tasks.json
*.code-workspace

# JetBrains (GoLand / IntelliJ IDEA)
.idea/

# === Системные файлы ===
.DS_Store
Thumbs.db
